# Konfigurasi Webcam
WEBCAM_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Konfigurasi Serial ESP32 (isi port spesifik seperti COM3, /dev/cu.usbserial-0001,
# atau gunakan AUTO untuk deteksi otomatis)
SERIAL_PORT=AUTO
SERIAL_BAUD=115200

# Konfigurasi Model YOLO ("classify" untuk yolo11n-cls atau "detect" untuk yolo11n)
YOLO_TASK=classify
MODEL_PATH=runs/classify/smart_bin_cls/weights/best.pt

# Ambang keputusan klasifikasi dalam jendela waktu (window)
CONFIDENCE_THRESHOLD=0.60
MAJORITY_RATIO=0.60
CLASSIFY_WINDOW_SEC=1.5
